# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local working notes — not published. README.md is the only tracked markdown.
*.md
!/README.md

# Scratch artifacts from local runs
/scratch_traj.npz
/sweep_out.json

# Migration backups. Retained on disk for the working copy; the pre-migration
# file is recoverable from git regardless, since docs/monte_carlo.json is
# tracked (`git show <commit>:docs/monte_carlo.json`).
*.pre-tag-migration.bak
